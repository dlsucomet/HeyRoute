OPENROUTER_API_KEY=... # Generate your own key via OpenRouter
GEOAPIFY_API_KEY=... # Generate your own key via Geoapify
ORS_API_KEY=... # Generate your own key via OpenRouteService
GROQ_API_KEY=... # Generate your own key via Groq
GOOGLE_MAPS_API_KEY=... # Enable the Routes API in Google Cloud Console

# Supabase: From your project's API settings
SUPABASE_URL=...
SUPABASE_SERVICE_KEY=...

# Setup your own backend server (http://IP_ADDRESS:PORT/MODULE)
MODEL_URL=...

# Backend Config
PORT=... # Default port is 80
HOST=.... # Default host is 0.0.0.0